 static void himax_lock(struct himax_ts_data *ts)
 {
+	unsigned long flags;
+
+	/*
+	 * Remember whether the interrupt was live before masking it: quiesce_irq()
+	 * only disables, and the original unlock() never re-enabled, so *every*
+	 * sysfs access used to leave the touch interrupt masked until the next
+	 * full re-init.  That silently invalidated a whole round of idle-mode
+	 * measurements (any "AFE command stops the stream" reading was really
+	 * "writing a sysfs attribute stopped the host from servicing the IRQ").
+	 */
+	spin_lock_irqsave(&ts->irq_lock, flags);
+	ts->irq_resume = ts->irq_enabled;
+	spin_unlock_irqrestore(&ts->irq_lock, flags);
+
 	himax_quiesce_irq(ts);
 	mutex_lock(&ts->op_lock);
 }
 
 static void himax_unlock(struct himax_ts_data *ts)
 {
+	bool resume = ts->irq_resume && ts->panel_enabled &&
+		      !ts->idle_active && !ts->shutting_down;
+
 	mutex_unlock(&ts->op_lock);
+	if (resume)
+		himax_int_enable(ts, true);
+	ts->irq_resume = false;
 }
 
