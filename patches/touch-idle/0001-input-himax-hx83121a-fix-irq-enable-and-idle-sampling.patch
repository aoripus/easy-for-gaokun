+/*
+ * Run the touch algorithm over the frame currently sitting in ts->event_buf
+ * and report the result to the input layer.  The caller must hold op_lock and
+ * must have read a frame into ts->event_buf already.
+ *
+ * Shared between the interrupt thread and the idle poll so both see the same
+ * debounce state.
+ */
+static int himax_process_frame(struct himax_ts_data *ts)
+{
+	struct hx_algo *algo = ts->algo;
+	struct input_mt_pos pos[HIMAX_MAX_TOUCH];
+	int stable_cnt;
+	int cnt;
+	bool report_on = true;
+
+	hx_preprocess_frame(algo, (u16 *)(ts->event_buf + OFST));
+	hx_detect_macro_zones(algo);
+	hx_reject_palms(algo);
+	hx_detect_peaks(algo);
+	hx_expand_and_resolve(algo, pos, &cnt);
+	hx_track_contacts(algo, pos, cnt);
+	stable_cnt = hx_count_stable_tracks(algo);
+
+	if (stable_cnt > 0 && !algo->touch_active) {
+		algo->touch_start_frames++;
+		if (algo->touch_start_frames < algo->track_start_debounce)
+			report_on = false;
+		else
+			algo->touch_active = true;
+	} else if (stable_cnt == 0) {
+		algo->touch_start_frames = 0;
+		algo->touch_active = false;
+	}
+
+	/* 这里报告给系统的坐标数据可以通过 evtest 查看 */
+	himax_report_tracked_state(ts, report_on);
+
+	return stable_cnt;
+}
+
+static unsigned long himax_idle_period_jiffies(void)
+{
+	unsigned int ms = idle_poll_ms < HIMAX_AFE_IDLE_POLL_MIN_MS ?
+			  HIMAX_AFE_IDLE_POLL_MIN_MS : idle_poll_ms;
