+
+/*
+ * One SPI frame read straight out of the firmware event stack, summarised as
+ * two checksums.  Reading it twice with a delay tells us whether the IC is
+ * still scanning after an AFE command: an idle IC that stopped scanning
+ * returns frozen data, a merely "quiet" one keeps producing new frames.
+ */
+static ssize_t frame_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct himax_ts_data *ts = dev_get_drvdata(dev);
+	u32 sum = 0, grid = 0;
+	u16 *p;
+	int i, ret;
+
+	himax_lock(ts);
+	ret = himax_mcu_interface_on(ts);
+	if (!ret)
+		ret = hx83121a_gaokun_read_event_stack(ts);
+	himax_unlock(ts);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < ts->event_buf_sz; i++)
+		sum += ts->event_buf[i];
+
+	p = (u16 *)(ts->event_buf + OFST);
+	for (i = 0; i < 16; i++)
+		grid += p[i];
+
+	return sysfs_emit(buf, "bytes_sum=%u grid16_sum=%u head=%*ph\n",
+			  sum, grid, 32, ts->event_buf);
+}
+
+/*
+ * Raw AHB access, for characterising firmware registers that no public source
+ * documents.  Gated by allow_raw_ahb and never enabled in a release build.
+ *   echo "r <addr> [len]"            > regs
+ *   echo "w <addr> <b0> <b1> ..."    > regs
+ */
+static ssize_t regs_store(struct device *dev, struct device_attribute *attr,
+			  const char *buf, size_t count)
+{
+	struct himax_ts_data *ts = dev_get_drvdata(dev);
+	unsigned int addr, len = HIMAX_REG_SZ;
+	u8 data[64];
+	const char *p = buf;
+	char op;
+	int i, ret;
+	int consumed = 0;
+
+	if (!allow_raw_ahb) {
+		dev_warn(ts->dev, "raw AHB access disabled (allow_raw_ahb=0)\n");
+		return -EPERM;
+	}
+
+	if (sscanf(p, " %c %x%n", &op, &addr, &consumed) != 2)
+		return -EINVAL;
+	p += consumed;
+
+	if (op == 'r') {
+		if (sscanf(p, " %x", &len) != 1)
+			len = HIMAX_REG_SZ;
+		if (!len || len > sizeof(data))
+			return -EINVAL;
+
+		himax_lock(ts);
+		ret = himax_mcu_register_read(ts, addr, data, len);
+		himax_unlock(ts);
+		if (ret)
+			return ret;
+
+		dev_info(ts->dev, "AHB R %08x (%u): %*ph\n", addr, len,
+			 (int)len, data);
+		return count;
+	}
+
+	if (op == 'w') {
+		unsigned int val;
+		int n = 0;
+
+		while (n < (int)sizeof(data) &&
+		       sscanf(p, " %x%n", &val, &i) == 1) {
+			data[n++] = val & 0xff;
+			p += i;
+		}
+		if (!n)
+			return -EINVAL;
+
+		himax_lock(ts);
+		ret = himax_mcu_register_write(ts, addr, data, n);
+		if (!ret)
+			ret = himax_mcu_register_read(ts, addr, data, n);
+		himax_unlock(ts);
+		if (ret)
+			return ret;
+
+		dev_info(ts->dev, "AHB W %08x (%d): %*ph\n", addr, n, n, data);
+		return count;
+	}
+
+	return -EINVAL;
+}
