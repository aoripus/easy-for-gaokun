+/*
+ * Explicit interrupt gate for experiments: masking the interrupt must not stop
+ * the IC from scanning (the mask lives in the TLMM, not on the SPI link), which
+ * is exactly what a host-side idle policy needs -- frames stay readable while
+ * the host stops paying for one interrupt per frame.
+ */
+static ssize_t irq_gate_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct himax_ts_data *ts = dev_get_drvdata(dev);
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+
+	himax_lock(ts);
+	himax_int_enable(ts, !on);
+	ts->irq_resume = false;
+	himax_unlock(ts);
+
+	dev_info(ts->dev, "diagnostic: interrupt %s\n", on ? "masked" : "live");
 	return count;
 }
 
